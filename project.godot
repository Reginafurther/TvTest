[application]
config/name="万界冒险团 V0.31 可视化试玩版"
config/features=PackedStringArray("4.3")
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1440
window/size/viewport_height=768
window/size/window_width_override=1440
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.075, 1)

[input]
pause_battle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
toggle_inventory={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":66)]
}

